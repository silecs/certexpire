[Unit]
Description=Check TLS certificates every day

[Timer]

# Start the unit every morning.
OnCalendar=*-*-* 00:05:00

# Avoid synchronous hammering in general.
RandomizedDelaySec=1h

# If the system was down at the time of launch,
# then start the unit as soon as the system is alive
# and the time is set/synchronized.
# Only effective with a OnCalendar= directive.
Persistent=true

[Install]
WantedBy=timers.target
