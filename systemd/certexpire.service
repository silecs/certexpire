# This user service will check the expiration date
#  of the TLS certificates of these targets,
#  and display a notification if any is too soon (10 days by default).
#
# The file ~/.config/certexpire.env should contain a line
# TARGETS = a.com b.org
# A long list can spread on several lines that end with "\".

[Unit]
Description=Check TLS certificates and notify errors
OnFailure=notify-failure.service

[Service]

EnvironmentFile=%E/certexpire.env
# This is a user service, so %E maps to "$XDG_CONFIG_HOME".
#   For details see "Specifiers" in `man systemd.unit`.

ExecStart=%h/.local/bin/certexpire $TARGETS
# Fix or remove the absolute path if necessary.
#   The deb package will install into /usr/bin ;
#   in this case a path is not required.
#   If the executable is not in /usr/local/bin/ or /usr/bin/,
#   an absolute path is mandatory.
# The command does not use the syntax ${TARGETS},
#   so the variable will be expanded in multiple arguments.
# See "COMMAND LINES" in `man systemd.service` for details.

# This file intentionally has no [Install] block,
#   so `systemctl enable` won't work with this unit.
# Use `systemctl enable|start` on the timer.
